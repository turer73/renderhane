# ===========================================
# Renderhane (renderhane.com) Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values.
# For Vercel deployment, set these in the Vercel dashboard.
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://renderhane.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# fal.ai
FAL_KEY=key_id:key_secret
FAL_WEBHOOK_SECRET=your-fal-webhook-secret

# iyzico
IYZICO_API_KEY=your-api-key
IYZICO_SECRET_KEY=your-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=renderhane-assets

# Relief Pro kapalı test atölyesi (server-only; NEXT_PUBLIC_ kullanmayın).
# Bu branch'te production etkinleştirilmemiştir.
# RELIEF_WORKSHOP_ENABLED=false
# RELIEF_WORKSHOP_URL=https://relief-workshop.renderhane.com
# Production/preview'da URL kodda sabitlenen exact HTTPS origin olmalıdır:
# https://relief-workshop.renderhane.com
# RELIEF_WORKSHOP_TOKEN=generate-at-least-32-random-characters
# Cloudflare Access kullanılıyorsa ikisini birlikte ayarlayın:
# RELIEF_WORKSHOP_ACCESS_CLIENT_ID=...
# RELIEF_WORKSHOP_ACCESS_CLIENT_SECRET=...
R2_PUBLIC_URL=https://assets.renderhane.com
